# Copy to docker/.env and set secrets before running docker compose.

JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string

# URL the browser uses to reach the client (nginx)
CLIENT_URL=http://localhost

# Optional payment integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
